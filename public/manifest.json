{
  "manifest_version": 3,
  "name": "Mass Schedule for Discord",
  "version": "1.0.0",
  "description": "Queue up a run of Discord scheduled messages at a fixed interval, in one click.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mass Schedule",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
